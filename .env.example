# Optional Gemini API key for live Google Search Grounding & AI classification
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Server port
PORT=3000

# MongoDB persistence (local or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/careerrelay
MONGODB_DB=careerrelay

# Optional Gmail SMTP & IMAP (Google App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Admin password to protect the web dashboard and /api/* routes when hosted online
ADMIN_PASSWORD=
SESSION_SECRET=
